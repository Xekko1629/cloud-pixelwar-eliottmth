{
  "name": "pixelwar",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["shared", "functions/*", "frontend"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "emulators": "firebase emulators:start --project demo-pixelwar-test --only firestore,pubsub",
    "test:integration": "firebase emulators:exec --project demo-pixelwar-test --only firestore,pubsub 'vitest run --config vitest.integration.config.ts'"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@google-cloud/firestore": "9.4.0",
    "@google-cloud/pubsub": "6.3.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "firebase-tools": "15.34.2",
    "jsdom": "30.1.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
