{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "shared/**/*.ts",
    "functions/**/*.ts",
    "frontend/**/*.ts",
    "testing/**/*.ts",
    "vitest*.ts"
  ],
  "exclude": ["node_modules", "coverage"]
}
