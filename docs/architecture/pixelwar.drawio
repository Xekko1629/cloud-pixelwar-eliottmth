        <mxCell id="page-subtitle" value="Socle déclaré et exploitation cible · GKE réservé aux runners CI" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#243247;strokeColor=none;fillColor=none;">
