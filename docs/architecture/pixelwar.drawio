        <mxCell id="page-title" value="3 · Plateforme et exploitation" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=28;fontStyle=1;fontColor=#243247;strokeColor=none;fillColor=none;">
